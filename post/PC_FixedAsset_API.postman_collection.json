                            "raw": "{\n  \"assetNumber\": \"FA-2024-002\",\n  \"assetName\": \"印表機\",\n  \"unit\": \"台\",\n  \"acquisitionDate\": \"2024-01-20\",\n  \"initialQuantity\": 1,\n  \"keeperId\": 2,\n  \"departmentId\": 1,\n  \"acquisitionAmount\": 1,\n  \"acquisitionPrice\": 8000,\n  \"mainAssetNumber\": \"FA-2024\"\n}"
                        },
                        "url": {
                            "raw": "{{devUrl}}/api/pc/assets",
                            "host": [
                                "{{devUrl}}"
                            ],
                            "path": [
