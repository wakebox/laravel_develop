                                    "value": "FA-2024-001",
                                    "description": "財產編號 (必填)"
                                }
                            ]
                        },
                        "description": "## 根據財產編號查詢\n\n**功能說明：** 根據財產編號查詢單筆資產詳細資料\n\n**查詢參數：**\n- `assetNumber`: 財產編號 (必填)"
                    },
                    "response": []
                },
                {
                    "name": "5. 取得單筆固定資產",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{devUrl}}/api/pc/assets/{{assetId}}",
                            "host": [
                                "{{devUrl}}"
                            ],
