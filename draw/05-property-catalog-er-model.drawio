<mxfile host="app.diagrams.net" modified="2026-01-27T00:00:00.000Z" agent="5.0" version="24.0.0" etag="drawio-er-property-catalog">
  <diagram name="財產目錄 ER Model" id="er-diagram-property-catalog">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- 標題 -->
        <mxCell id="title" value="財產目錄報表 ER Model" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="520" y="20" width="560" height="40" as="geometry" />
        </mxCell>

        <!-- 固定資產主表 pc_fixed_assets -->
        <mxCell id="fixed_assets" value="pc_fixed_assets (固定資產主表)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="300" height="420" as="geometry" />
        </mxCell>
        <mxCell id="fixed_assets_fields" value="PK  id: bigint (主鍵)&#xa;UK  asset_number: varchar(50) 財產編號*&#xa;    asset_name: varchar(200) 財產名稱*&#xa;    asset_spec: varchar(500) 資產規格&#xa;FK  department_id: bigint 部門編號*&#xa;FK  keeper_id: bigint 保管人ID*&#xa;    unit: varchar(20) 單位*&#xa;    stock_value: int 庫存數量*&#xa;    acquisition_date: date 取得日期&#xa;    acquisition_price: bigint 取得成本*&#xa;    cost_not_depreciated: bigint 成本總額*&#xa;    add_amount: bigint 增添改良&#xa;    useful_life_months: int 耐用年限_個月*&#xa;    used_life_months: int 續用年限_個月&#xa;    initial_quantity: tinyint 列管/列帳*&#xa;FK  account_subject: varchar(50) 帳務科目*&#xa;    created_at: timestamp&#xa;    updated_at: timestamp&#xa;    deleted_at: timestamp&#xa;&#xa;【報表查詢欄位】&#xa;- 依部門編號、保管人、列管列帳、總帳科目過濾&#xa;- 期末殘值為0可選擇不顯示&#xa;- 庫存數量為0可選擇不顯示" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="fixed_assets">
          <mxGeometry y="30" width="300" height="390" as="geometry" />
        </mxCell>

        <!-- 資產每月攤提明細表 -->
        <mxCell id="depreciation_details" value="pc_asset_monthly_depreciation_details (每月攤提明細)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="100" width="320" height="340" as="geometry" />
        </mxCell>
        <mxCell id="depreciation_details_fields" value="PK  id: bigint (主鍵)&#xa;FK  asset_id: bigint 資產ID*&#xa;    depreciation_month: varchar(10) 折舊年月*&#xa;    monthly_amortization: bigint 每月攤提*&#xa;    accumulated_depreciation: bigint 累積折舊*&#xa;    closed_flag: char(1) 月結註記 (Y/N)&#xa;    created_at: timestamp&#xa;    updated_at: timestamp&#xa;&#xa;【報表計算欄位】&#xa;◆ 期初累折:&#xa;  - 取得該年度1月份之前一個月累折金額&#xa;  - 例: 報表年度=2025, 取2024/12之累積折舊&#xa;&#xa;◆ 本期折舊:&#xa;  - 當年度(每個月)已月結之每月折舊金額累加&#xa;  - 只計算closed_flag=Y的記錄&#xa;&#xa;◆ 期末累折:&#xa;  - 期初累折 + 本期折舊&#xa;&#xa;◆ 期末殘值:&#xa;  - 成本總額 - 期末累折" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="depreciation_details">
          <mxGeometry y="30" width="320" height="310" as="geometry" />
        </mxCell>

        <!-- OA部門主檔 -->
        <mxCell id="departments" value="sc_departments (OA部門主檔)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="920" y="100" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="departments_fields" value="PK  id: bigint&#xa;    code: varchar(20) 部門編號&#xa;    name: varchar(100) 部門名稱&#xa;    created_at: timestamp&#xa;    updated_at: timestamp" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="departments">
          <mxGeometry y="30" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- OA員工主檔 -->
        <mxCell id="users" value="sc_users (OA員工主檔)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="920" y="260" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="users_fields" value="PK  id: bigint&#xa;    employee_id: varchar(20) 員工編號&#xa;    name: varchar(100) 員工姓名&#xa;FK  department_id: bigint 部門ID&#xa;    created_at: timestamp&#xa;    updated_at: timestamp" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="users">
          <mxGeometry y="30" width="220" height="110" as="geometry" />
        </mxCell>

        <!-- OA會計科目主檔 -->
        <mxCell id="account_subjects" value="sc_account_subjects (OA會計科目主檔)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="580" width="240" height="140" as="geometry" />
        </mxCell>
        <mxCell id="account_subjects_fields" value="PK  id: bigint&#xa;    code: varchar(20) 科目代碼&#xa;    name: varchar(100) 科目名稱&#xa;    type: varchar(20) 科目類型&#xa;    created_at: timestamp&#xa;    updated_at: timestamp" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="account_subjects">
          <mxGeometry y="30" width="240" height="110" as="geometry" />
        </mxCell>

        <!-- 業務規則說明 -->
        <mxCell id="business_rules" value="【業務規則說明】" style="swimlane;fontStyle=1;align=left;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="480" width="640" height="500" as="geometry" />
        </mxCell>
        <mxCell id="business_rules_content" value="【報表目的】&#xa;財產清冊明細報表&#xa;&#xa;【查詢條件說明】&#xa;◆ 部門編號(起/迄):&#xa;  - 多選清單-OA部門清單&#xa;  - 依部門編號(首碼)排序後進行區間範圍搜尋&#xa;&#xa;◆ 保管人:&#xa;  - 多選選單-OA員工清單&#xa;  - 依資產之保管人作為條件&#xa;&#xa;◆ 列管/列帳:&#xa;  - 下拉選單-(同資產基本檔列管/列帳清單)&#xa;  - 1=列管且列帳, 2=列管不列帳, 3=列帳不列管&#xa;&#xa;◆ 總帳科目:&#xa;  - 下拉選單-OA會計科目清單&#xa;&#xa;◆ 期末殘值為0不顯示:&#xa;  - Check BOX, 預設Y&#xa;  - 依設備之成本總價-累積折舊費用若<=0, 則不顯示&#xa;&#xa;◆ 庫存數量為0不顯示:&#xa;  - Check BOX, 預設Y&#xa;  - 依資產之庫存數量進行篩選&#xa;&#xa;【報表內容】&#xa;◆ 分頁條件:&#xa;  - 依部門+總帳科目進行拆分&#xa;  - 資產之同一部門+總帳科目相同, 才會在一個分頁中&#xa;&#xa;◆ 表頭欄位:&#xa;  - 公司名稱: 依客戶公司名稱顯示&#xa;  - 頁次: 依頁次顯示&#xa;  - 印表日期: 依系統日顯示 (YYY/MM/DD)&#xa;  - 部門編號: 依資產之部門編號&#xa;  - 總帳科目: 依資產之總帳科目&#xa;&#xa;◆ 表格欄位:&#xa;  1. 財產編號: 依資產基本資訊之財產編號&#xa;  2. 財產名稱: 依資產基本資訊之財產名稱&#xa;  3. 資產取得日期: 依資產基本資訊之取得日期&#xa;  4. 單位: 依資產基本資訊之單位&#xa;  5. 數量: 依資產基本資訊之庫存數量&#xa;  6. 取得成本: 依資產基本資訊之取得成本&#xa;  7. 增添改良: 依資產基本資訊之增添改良&#xa;  8. 耐用月數: 依資產基本資訊之耐用年限_個月&#xa;  9. 續用月數: 依資產基本資訊之續用年限_個月&#xa;  10. 期初累折: 依該資產之每月攤提建立作業中,&#xa;       取得該年度1月份之前一個月累折金額&#xa;  11. 本期折舊: 依該資產之每月攤提建立作業中,&#xa;       當年度(每個月)已月結之每月折舊金額累加&#xa;  12. 期末累折: 期初折舊+本期折舊&#xa;  13. 期末殘值: 依該資產之成本總額-期末累折&#xa;&#xa;【計算邏輯】&#xa;◆ 期初累折:&#xa;  - 查詢該資產在報表年度1月份之前一個月的累積折舊&#xa;  - 例如報表年度為2025年, 則查詢2024/12的累積折舊&#xa;&#xa;◆ 本期折舊:&#xa;  - 查詢該資產在報表年度內所有已月結(closed_flag=Y)的每月攤提金額&#xa;  - 將這些金額累加得到本期折舊&#xa;&#xa;◆ 期末累折:&#xa;  - 期初累折 + 本期折舊&#xa;&#xa;◆ 期末殘值:&#xa;  - 成本總額 - 期末累折&#xa;  - 若期末殘值<=0且「期末殘值為0不顯示」勾選, 則不顯示該筆資料&#xa;&#xa;【排序規則】&#xa;- 先依部門編號排序&#xa;- 再依總帳科目排序&#xa;- 最後依財產編號排序" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="business_rules">
          <mxGeometry y="30" width="640" height="470" as="geometry" />
        </mxCell>

        <!-- 關聯線 -->
        <!-- fixed_assets -> depreciation_details -->
        <mxCell id="rel1" value="" style="endArrow=ERmany;html=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=ERone;startFill=0;endFill=0;" edge="1" parent="1" source="fixed_assets" target="depreciation_details">
