        <mxCell id="rel3_label" value="1 : N&#xa;折舊部門" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="rel3">
          <mxGeometry x="-0.1" y="1" relative="1" as="geometry">
