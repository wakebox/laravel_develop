        <!-- departments -> depreciation_details -->
        <mxCell id="rel3" value="" style="endArrow=ERmany;html=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;startArrow=ERone;startFill=0;endFill=0;" edge="1" parent="1" source="departments" target="depreciation_details">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="850" y="400"/>
              <mxPoint x="850" y="430"/>
