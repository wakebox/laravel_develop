<mxfile host="app.diagrams.net" modified="2026-01-27T00:00:00.000Z" agent="5.0" version="24.0.0" etag="drawio-er-batch-depreciation">
  <diagram name="批次攤提折舊作業 ER Model" id="er-diagram-batch-depreciation">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- 標題 -->
        <mxCell id="title" value="批次攤提折舊作業 ER Model" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="600" height="40" as="geometry" />
        </mxCell>

        <!-- 固定資產主表 pc_fixed_assets -->
        <mxCell id="fixed_assets" value="pc_fixed_assets (固定資產主表)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="280" height="320" as="geometry" />
        </mxCell>
        <mxCell id="fixed_assets_fields" value="PK  id: bigint (主鍵)&#xa;UK  asset_number: varchar(50) 財產編號*&#xa;    asset_name: varchar(200) 財產名稱*&#xa;    asset_spec: varchar(500) 資產規格&#xa;FK  department_id: bigint 部門編號* (保管部門)&#xa;    acquisition_price: bigint 取得成本*&#xa;    cost_not_depreciated: bigint 成本總額*&#xa;    budget_source: bigint 預留殘值*&#xa;    stock_value: int 庫存數量*&#xa;    initial_quantity: tinyint 列管/列帳*&#xa;    start_date: varchar(10) 開始提列年月*&#xa;    useful_life_months: int 耐用年限_個月*&#xa;    used_life_months: int 續用年限_個月&#xa;    created_at: timestamp&#xa;    updated_at: timestamp&#xa;    deleted_at: timestamp" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="fixed_assets">
          <mxGeometry y="30" width="280" height="290" as="geometry" />
        </mxCell>

        <!-- 資產每月攤提修改作業主表 -->
        <mxCell id="monthly_depreciation" value="pc_asset_monthly_depreciation (每月攤提主表)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="100" width="300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="monthly_depreciation_fields" value="PK  id: bigint (主鍵)&#xa;FK  asset_id: bigint 資產ID*&#xa;UK  asset_number: varchar(50) 財產編號*&#xa;    asset_name: varchar(200) 財產名稱&#xa;    asset_spec: varchar(500) 資產規格&#xa;    budget_source: bigint 預留殘值&#xa;    created_at: timestamp&#xa;    updated_at: timestamp&#xa;&#xa;【說明】批次產生每月攤提記錄" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="monthly_depreciation">
          <mxGeometry y="30" width="300" height="170" as="geometry" />
        </mxCell>

        <!-- 資產每月攤提明細表 -->
        <mxCell id="depreciation_details" value="pc_asset_monthly_depreciation_details (每月攤提明細)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="920" y="100" width="320" height="440" as="geometry" />
        </mxCell>
        <mxCell id="depreciation_details_fields" value="PK  id: bigint (主鍵)&#xa;FK  monthly_depreciation_id: bigint 每月攤提主表ID*&#xa;FK  asset_id: bigint 資產ID*&#xa;    depreciation_month: varchar(10) 折舊年月*&#xa;       (需扣除已月結之月份)&#xa;    cost_total: bigint 成本總額&#xa;    monthly_amortization: bigint 每月攤提*&#xa;       公式:(成本總額-預留殘值-累積折舊)/耐用年限&#xa;    accumulated_depreciation: bigint 累積折舊&#xa;FK  department_id: bigint 折舊部門*&#xa;       (依保管部門或指定部門)&#xa;    closed_flag: char(1) 月結註記 (Y/N)&#xa;    created_at: timestamp&#xa;    updated_at: timestamp&#xa;&#xa;【計算邏輯】&#xa;- 折舊年月: 從開始提列年月或最大已月結+1開始&#xa;- 每月攤提: (成本總額-預留殘值-累積折舊)/耐用年限&#xa;- 折舊部門: 依保管部門設定Y則用保管部門,N則用指定部門&#xa;&#xa;【重新產生規則】&#xa;- 已月結資料不重新產生&#xa;- 只產生未月結月份之折舊資料&#xa;- 需扣除已月結之月份數" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="depreciation_details">
          <mxGeometry y="30" width="320" height="410" as="geometry" />
        </mxCell>

        <!-- OA部門主檔 -->
        <mxCell id="departments" value="sc_departments (OA部門主檔)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="340" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="departments_fields" value="PK  id: bigint&#xa;    code: varchar(20) 部門編號&#xa;    name: varchar(100) 部門名稱&#xa;    created_at: timestamp&#xa;    updated_at: timestamp" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="departments">
          <mxGeometry y="30" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- 業務規則說明 -->
        <mxCell id="business_rules" value="【業務規則說明】" style="swimlane;fontStyle=1;align=left;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="480" width="700" height="500" as="geometry" />
        </mxCell>
        <mxCell id="business_rules_content" value="【作業目的】&#xa;批次建立固定資產折舊資料&#xa;&#xa;【作業流程】&#xa;1. 從資產基本檔複選資產 (可多選)&#xa;2. 設定折舊部門依保管部門設定 (預設Y)&#xa;3. 若設定為N,則需指定折舊部門&#xa;4. 點擊確定後批次產生每月攤提修改作業資料&#xa;&#xa;【資產過濾條件】&#xa;◆ 需過濾資料:&#xa;  1. 若資產之列管/列帳=2(列管不列帳),無法選擇&#xa;  2. 該資產之庫存數量已為0&#xa;  3. 已產生過折舊之資產(依業務需求)&#xa;&#xa;【欄位說明】&#xa;◆ 財產編號:&#xa;  - 多選式選單&#xa;  - 可從資產基本檔中複選資產&#xa;  - 需套用上述過濾條件&#xa;&#xa;◆ 攤提次數:&#xa;  - 唯讀欄位&#xa;  - 系統自動計算&#xa;&#xa;◆ 折舊部門依保管部門設定:&#xa;  - Check Box, 預設為Y&#xa;  - Y: 使用資產保管部門作為折舊部門&#xa;  - N: 使用下方指定之折舊部門&#xa;&#xa;◆ 部門:&#xa;  - 當折舊部門依保管部門設定為N時,此欄位才可下拉挑選&#xa;  - 當折舊部門依保管部門設定為Y時,此欄位唯讀&#xa;&#xa;【資料處理邏輯】&#xa;◆ 資料產生:&#xa;  - 依頁面數據產生每月攤提修改作業資料&#xa;  - 每個資產僅產生一次單頭記錄&#xa;  - 單身依續用年限產生對應筆數&#xa;&#xa;◆ 重新產生機制:&#xa;  - 若該筆資料尚未月結(月結註記=N),可重新產生&#xa;  - 已月結資料(月結註記=Y)不重新產生&#xa;  - 範例: A資產耐用年限60個月,已月結5個月&#xa;    重新產生時只產生(60-5)=55個月之折舊資料&#xa;&#xa;【折舊年月計算】&#xa;- 需關聯該資產對應之「資產每月攤提修改作業」&#xa;- 取單身之最大折舊年月+1個月&#xa;- 若尚無任何資料,則取資產基本檔之開始提列年月&#xa;- 並依耐用年限往後產生資料&#xa;- 需扣除已月結之月份&#xa;&#xa;【金額計算公式】&#xa;◆ 成本總額:&#xa;  - 依該資產於資產建立作業中對應之取得成本&#xa;&#xa;◆ 每月攤提:&#xa;  - 公式: (成本總額-預留殘值-累積折舊)/耐用年限&#xa;  - 四捨五入到整數位&#xa;  - 注意: 與一般折舊公式不同,需扣除累積折舊&#xa;&#xa;◆ 累積折舊:&#xa;  - 由第一個折舊年月+每月攤提逐步遞增&#xa;&#xa;◆ 折舊部門:&#xa;  - 若折舊部門依保管部門設定=Y: 直接取用設備基本檔設定之部門&#xa;  - 若折舊部門依保管部門設定=N: 以批次折舊作業指定之折舊部門為主&#xa;&#xa;【月結註記】&#xa;- 唯讀欄位&#xa;- 後續透過資產月結作業回寫&#xa;- N=未月結, Y=已月結&#xa;&#xa;【查詢條件】&#xa;無特殊查詢條件設定" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="business_rules">
          <mxGeometry y="30" width="700" height="470" as="geometry" />
        </mxCell>

        <!-- 關聯線 -->
        <!-- fixed_assets -> monthly_depreciation -->
        <mxCell id="rel1" value="" style="endArrow=ERmany;html=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=ERone;startFill=0;endFill=0;" edge="1" parent="1" source="fixed_assets" target="monthly_depreciation">
