  <diagram name="資產盤點明細表 ER Model" id="er-diagram-inventory-report">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- 標題 -->
        <mxCell id="title" value="資產盤點明細表 ER Model" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="450" y="20" width="700" height="40" as="geometry" />
        </mxCell>

        <!-- 資產主檔 -->
        <mxCell id="fixed_assets" value="pc_fixed_assets (資產主檔)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="320" height="420" as="geometry" />
        </mxCell>
        <mxCell id="fixed_assets_fields" value="PK  id: bigint (主鍵)&#xa;UK  asset_number: varchar(50) 資產編號*&#xa;    asset_name: varchar(200) 資產名稱*&#xa;    specification: varchar(500) 規格&#xa;    quantity: int 數量*&#xa;    unit: varchar(20) 單位*&#xa;FK  asset_class_id: bigint 資產分類ID*&#xa;FK  asset_category_id: bigint 資產類別ID*&#xa;FK  asset_attribute_id: bigint 資產屬性ID*&#xa;FK  department_id: bigint 使用部門ID*&#xa;    department_name: varchar(100) 使用部門名稱&#xa;FK  storage_location_id: bigint 存放位置ID&#xa;    storage_location: varchar(200) 存放位置&#xa;FK  keeper_id: bigint 保管人ID&#xa;    keeper_name: varchar(100) 保管人姓名&#xa;    acquisition_date: date 取得日期*&#xa;    original_value: bigint 原始成本*&#xa;    residual_rate: decimal(5,2) 殘值率%&#xa;    depreciation_years: int 折舊年限*&#xa;FK  depreciation_category: varchar(50) 折舊科目*&#xa;FK  cumulative_category: varchar(50) 累積折舊科目*&#xa;    created_at: timestamp&#xa;    updated_at: timestamp" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="fixed_assets">
          <mxGeometry y="30" width="320" height="390" as="geometry" />
        </mxCell>

        <!-- 資產盤點底稿 -->
        <mxCell id="inventory_draft" value="pc_asset_inventory_draft (盤點底稿)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="550" y="100" width="360" height="340" as="geometry" />
        </mxCell>
        <mxCell id="inventory_draft_fields" value="PK  id: bigint (主鍵)&#xa;UK  fiscal_year: varchar(10) 會計年度*&#xa;UK  inventory_month: varchar(10) 盤點月份*&#xa;UK  sequence_number: int 序號* (流水號,從1開始)&#xa;FK  asset_id: bigint 資產ID*&#xa;    asset_number: varchar(50) 資產編號&#xa;    asset_name: varchar(200) 資產名稱&#xa;    specification: varchar(500) 規格&#xa;    quantity: int 數量&#xa;    unit: varchar(20) 單位&#xa;FK  department_id: bigint 使用部門ID&#xa;    department_name: varchar(100) 使用部門名稱&#xa;    storage_location: varchar(200) 存放位置&#xa;FK  keeper_id: bigint 保管人ID&#xa;    keeper_name: varchar(100) 保管人姓名&#xa;    acquisition_date: date 取得日期&#xa;    original_value: bigint 原始成本&#xa;    generated_date: date 產生日期 (預設=今日)&#xa;    status: varchar(20) 狀態 (GENERATED=已產生,EXPORTED=已匯出)&#xa;    created_at: timestamp&#xa;    updated_at: timestamp&#xa;&#xa;【說明】&#xa;- 每個會計年度+盤點月份+資產僅產生一筆&#xa;- 序號依產生順序自動賦予" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="inventory_draft">
          <mxGeometry y="30" width="360" height="310" as="geometry" />
        </mxCell>

        <!-- OA部門主檔 -->
        <mxCell id="departments" value="sc_departments (OA部門主檔)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1050" y="100" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="departments_fields" value="PK  id: bigint&#xa;    code: varchar(20) 部門編號&#xa;    name: varchar(100) 部門名稱&#xa;    created_at: timestamp&#xa;    updated_at: timestamp" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="departments">
          <mxGeometry y="30" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- OA員工主檔 -->
        <mxCell id="employees" value="sc_employees (OA員工主檔)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1050" y="260" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="employees_fields" value="PK  id: bigint&#xa;    code: varchar(20) 員工編號&#xa;    name: varchar(100) 員工姓名&#xa;    email: varchar(100) Email&#xa;    created_at: timestamp&#xa;    updated_at: timestamp" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="employees">
          <mxGeometry y="30" width="220" height="110" as="geometry" />
        </mxCell>

        <!-- 業務規則說明 -->
        <mxCell id="business_rules" value="【業務規則說明】" style="swimlane;fontStyle=1;align=left;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="570" width="800" height="550" as="geometry" />
        </mxCell>
        <mxCell id="business_rules_content" value="【作業目的】&#xa;提供資產盤點明細表查詢及產生底稿功能,供各部門進行年度資產盤點作業&#xa;&#xa;【作業流程】&#xa;1. 輸入會計年度(必填,格式:114)&#xa;2. 輸入盤點月份(必填,格式:01-12)&#xa;3. 選擇部門(選填,可複選)&#xa;4. 選擇保管人(選填,可複選)&#xa;5. 點擊「盤點底稿產生」按鈕&#xa;6. 系統依條件產生盤點底稿資料&#xa;7. 點擊「查詢」按鈕&#xa;8. 系統顯示符合條件之盤點底稿明細&#xa;9. 點擊「匯出Excel」按鈕&#xa;10. 系統匯出Excel檔案供下載&#xa;&#xa;【盤點底稿產生邏輯】&#xa;◆ 產生規則:&#xa;  - 依會計年度+盤點月份+部門+保管人條件篩選資產主檔&#xa;  - 若未選擇部門,則產生所有部門之資產&#xa;  - 若未選擇保管人,則產生所有保管人之資產&#xa;  - 每筆資產自動賦予流水號(序號)&#xa;  - 序號依資產編號排序,從1開始&#xa;&#xa;◆ 底稿內容:&#xa;  - 會計年度: 使用者輸入之會計年度&#xa;  - 盤點月份: 使用者輸入之盤點月份&#xa;  - 序號: 系統自動賦予流水號&#xa;  - 資產編號: 依資產主檔取得&#xa;  - 資產名稱: 依資產主檔取得&#xa;  - 規格: 依資產主檔取得&#xa;  - 數量: 依資產主檔取得&#xa;  - 單位: 依資產主檔取得&#xa;  - 使用部門: 依資產主檔取得&#xa;  - 存放位置: 依資產主檔取得&#xa;  - 保管人: 依資產主檔取得&#xa;  - 取得日期: 依資產主檔取得&#xa;  - 原始成本: 依資產主檔取得&#xa;  - 產生日期: 預設=今日&#xa;  - 狀態: 預設=GENERATED (已產生)&#xa;&#xa;◆ 重複產生檢查:&#xa;  - 若相同會計年度+盤點月份+資產已存在底稿,不允許重複產生&#xa;  - 系統需提示「該會計年度+盤點月份之底稿已存在,是否刪除後重新產生?」&#xa;  - 若點擊「是」,刪除原有底稿後重新產生&#xa;  - 若點擊「否」,取消產生作業&#xa;&#xa;【查詢邏輯】&#xa;◆ 查詢條件:&#xa;  - 會計年度: 必填,格式:114&#xa;  - 盤點月份: 必填,格式:01-12&#xa;  - 部門: 選填,可複選,預設=全部&#xa;  - 保管人: 選填,可複選,預設=全部&#xa;&#xa;◆ 查詢結果欄位:&#xa;  1. 序號&#xa;  2. 資產編號&#xa;  3. 資產名稱&#xa;  4. 規格&#xa;  5. 數量&#xa;  6. 單位&#xa;  7. 使用部門&#xa;  8. 存放位置&#xa;  9. 保管人&#xa;  10. 取得日期&#xa;  11. 原始成本&#xa;  12. 產生日期&#xa;&#xa;◆ 排序:&#xa;  - 依序號排序&#xa;&#xa;【Excel匯出邏輯】&#xa;◆ 檔案命名:&#xa;  - 資產盤點明細表_[會計年度]_[盤點月份].xlsx&#xa;&#xa;◆ 匯出內容:&#xa;  - Sheet名稱: 資產盤點明細表&#xa;  - 標題列: 資產盤點明細表&#xa;  - 副標題列: [會計年度]/[盤點月份]&#xa;  - 欄位標題列:&#xa;    序號 | 資產編號 | 資產名稱 | 規格 | 數量 | 單位 | 使用部門 | 存放位置 | 保管人 | 取得日期 | 原始成本 | 盤點結果 | 備註&#xa;  - 資料列: 依查詢結果顯示&#xa;  - 盤點結果欄位: 空白欄位供手寫&#xa;  - 備註欄位: 空白欄位供手寫&#xa;&#xa;◆ 匯出後處理:&#xa;  - 更新狀態為EXPORTED (已匯出)&#xa;&#xa;【欄位驗證】&#xa;◆ 會計年度: 必填,格式:3位數字&#xa;◆ 盤點月份: 必填,格式:2位數字,範圍01-12&#xa;◆ 部門: 選填,需存在於OA部門主檔&#xa;◆ 保管人: 選填,需存在於OA員工主檔&#xa;&#xa;【特殊說明】&#xa;- 底稿產生後,若需重新產生,系統會刪除原有底稿後重新產生&#xa;- 序號依產生順序自動賦予,從1開始&#xa;- 匯出Excel後,狀態更新為EXPORTED (已匯出)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="business_rules">
          <mxGeometry y="30" width="800" height="520" as="geometry" />
        </mxCell>

        <!-- 關聯線 -->
