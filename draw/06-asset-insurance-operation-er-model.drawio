  <diagram name="資產投保作業 ER Model" id="er-diagram-asset-insurance">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- 標題 -->
        <mxCell id="title" value="資產投保作業 ER Model" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="520" y="20" width="560" height="40" as="geometry" />
        </mxCell>

        <!-- 固定資產主表 -->
        <mxCell id="fixed_assets" value="pc_fixed_assets (固定資產主表)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="280" height="240" as="geometry" />
        </mxCell>
        <mxCell id="fixed_assets_fields" value="PK  id: bigint (主鍵)&#xa;UK  asset_number: varchar(50) 財產編號*&#xa;    asset_name: varchar(200) 財產名稱*&#xa;    asset_spec: varchar(500) 資產規格&#xa;FK  department_id: bigint 部門編號*&#xa;    investment: tinyint 投保狀態&#xa;       1=未投保 2=已投保 3=已到期&#xa;    created_at: timestamp&#xa;    updated_at: timestamp&#xa;    deleted_at: timestamp&#xa;&#xa;【說明】&#xa;- 投保狀態由投保作業自動回寫&#xa;- 保單到期系統自動更新狀態" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="fixed_assets">
          <mxGeometry y="30" width="280" height="210" as="geometry" />
        </mxCell>

        <!-- 資產投保作業表 -->
        <mxCell id="insurance" value="pc_asset_insurance (資產投保作業)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="100" width="300" height="460" as="geometry" />
        </mxCell>
        <mxCell id="insurance_fields" value="PK  id: bigint (主鍵)&#xa;UK  insurance_number: varchar(50) ERP投保單號*&#xa;       (系統自動賦予,依OA3.0單據架構)&#xa;FK  asset_id: bigint 資產ID*&#xa;    asset_number: varchar(50) 財產編號*&#xa;    asset_name: varchar(200) 財產名稱 (唯讀)&#xa;    asset_spec: varchar(500) 資產規格 (唯讀)&#xa;FK  department_id: bigint 部門編號 (唯讀)&#xa;    start_date: date 投保期間(起)*&#xa;    end_date: date 投保期間(迄)*&#xa;    insurance_type: varchar(100) 保險險別&#xa;       (火險、竊盜險、第三人責任險等)&#xa;    insurance_company: varchar(200) 承保公司&#xa;       (國泰人壽、三商美邦等)&#xa;    policy_number: varchar(100) 保單號碼&#xa;    insurance_amount: varchar(100) 投保金額&#xa;       (可文字或數字)&#xa;    insurance_note: text 投保備註&#xa;    status: tinyint 保單狀態*&#xa;       1=投保中 2=已結束 3=已到期&#xa;    created_at: timestamp 建立時間&#xa;    updated_at: timestamp 更新時間&#xa;    deleted_at: timestamp 刪除時間&#xa;&#xa;【說明】&#xa;- 存檔時回寫資產基本檔投保狀態=已投保&#xa;- 解除合約時回寫資產基本檔投保狀態=未投保&#xa;- 系統日>投保期間(迄)時,自動結案,狀態=已到期" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="insurance">
          <mxGeometry y="30" width="300" height="430" as="geometry" />
        </mxCell>

        <!-- OA部門主檔 -->
        <mxCell id="departments" value="sc_departments (OA部門主檔)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="920" y="100" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="departments_fields" value="PK  id: bigint&#xa;    code: varchar(20) 部門編號&#xa;    name: varchar(100) 部門名稱&#xa;    created_at: timestamp&#xa;    updated_at: timestamp" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="departments">
          <mxGeometry y="30" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- 業務規則說明 -->
        <mxCell id="business_rules" value="【業務規則說明】" style="swimlane;fontStyle=1;align=left;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="400" width="700" height="560" as="geometry" />
        </mxCell>
        <mxCell id="business_rules_content" value="【作業目的】&#xa;建立固定資產投保資料&#xa;&#xa;【基本區欄位說明】&#xa;◆ 財產編號:&#xa;  - 必填欄位&#xa;  - 可下拉選單or開窗查詢資產資料&#xa;  - 可用資產編號or資產名稱進行模糊搜尋&#xa;&#xa;◆ 資產名稱:&#xa;  - 唯讀欄位&#xa;  - 根據挑選出的財產編號帶出其對應資產名稱&#xa;&#xa;◆ 資產規格:&#xa;  - 唯讀欄位&#xa;  - 根據挑選出的財產編號帶出其對應資產規格&#xa;&#xa;◆ 部門編號:&#xa;  - 唯讀欄位&#xa;  - 根據挑選出的財產編號帶出其對應部門編號&#xa;&#xa;◆ ERP投保單號:&#xa;  - 無法編輯,系統自動賦予&#xa;  - 編碼原則: 請依OA3.0單據架構設計(RD補充)&#xa;&#xa;◆ 投保期間(起):&#xa;  - 必填欄位,萬年曆選單&#xa;&#xa;◆ 投保期間(迄):&#xa;  - 必填欄位,萬年曆選單&#xa;&#xa;◆ 保險險別:&#xa;  - 使用者自行輸入&#xa;  - 輸入資料範例: 火險、竊盜險、第三人責任險...等等&#xa;&#xa;◆ 承保公司:&#xa;  - 使用者自行輸入&#xa;  - 輸入資料範例: 國泰人壽、三商美邦...等等&#xa;&#xa;◆ 保單號碼:&#xa;  - 使用者自行輸入&#xa;&#xa;◆ 投保金額:&#xa;  - 使用者自行輸入&#xa;  - 只允許輸入正整數&#xa;  - 2025/12/16資產例會後決議,金額欄位可以以文字or數字存入&#xa;&#xa;◆ 投保備註:&#xa;  - 使用者自行輸入&#xa;&#xa;◆ 保單狀態:&#xa;  - 唯讀欄位&#xa;  - 存檔時寫入已投保&#xa;  - 解除合約時寫入未投保&#xa;&#xa;【資料處理】&#xa;◆ 按鈕_確定:&#xa;  - 當按下確定後,除了本身投保單據存檔外,還需處理資產基本檔&#xa;  - 資產基本檔.投保狀態需調整為已投保&#xa;&#xa;◆ 按鈕_解除合約:&#xa;  - 當按下解除合約後,系統需跳出提示訊息:&#xa;    「解約後,投保狀態將會更新,是否確認解約?」&#xa;  - 若點擊是,則直接作廢原本合約,並將投保狀態由已投保更新為未投保&#xa;&#xa;【投保結案設定】&#xa;- 當系統日已大於投保期間(迄),該保單自動結案&#xa;- 需將投保狀態調整為已到期&#xa;&#xa;【保單到期提醒】&#xa;◆ 提醒時機:&#xa;  - 當保單效期已不足兩個月,系統需發送郵件至該保管人信箱&#xa;&#xa;◆ 郵件內容:&#xa;  - 主旨: 資產編號:XXXXX 保險到期提醒&#xa;  - 內文: 資產編號:XXXXX 該資產之保單號碼:XXXXX&#xa;    再兩個月即將到期,請記得續保或其他相關處理&#xa;&#xa;◆ 提醒機制:&#xa;  - 暫定設定兩個月,後續可優化成使用設定檔天數來自定義提醒通知&#xa;  - 提醒機制可參考OA設定機制&#xa;&#xa;【OA列表欄位】&#xa;- 財產編號: 依資產基本資訊之財產編號&#xa;- 財產名稱: 依資產基本資訊之財產名稱&#xa;- ERP投保單號: 依ERP投保單號&#xa;- 投保日期: 依投保單之投保日期&#xa;- 保險險別: 依投保單之保險險別&#xa;- 保單號碼: 依投保單之保單號碼&#xa;&#xa;【查詢條件】&#xa;- 財產編號: 可依財產編號模糊搜尋&#xa;- 財產名稱: 可依財產名稱模糊搜尋&#xa;- ERP投保單號: 依ERP投保單號&#xa;- 投保日期(起): 依投保單之投保日期&#xa;- 投保日期(迄): 依投保單之投保日期&#xa;&#xa;【欄位驗證規則】&#xa;- 財產編號: 必填&#xa;- 投保期間(起): 必填,日期格式&#xa;- 投保期間(迄): 必填,日期格式,需大於起始日期&#xa;- 投保金額: 正整數或文字&#xa;- ERP投保單號: 系統自動產生,唯一值" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="business_rules">
          <mxGeometry y="30" width="700" height="530" as="geometry" />
        </mxCell>

