<mxfile host="app.diagrams.net" modified="2026-01-27T00:00:00.000Z" agent="5.0" version="24.0.0" etag="drawio-er-disposal-operation">
  <diagram name="資產處置作業 ER Model" id="er-diagram-disposal-operation">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- 標題 -->
        <mxCell id="title" value="資產處置作業 ER Model" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="450" y="20" width="700" height="40" as="geometry" />
        </mxCell>

        <!-- 資產主檔 -->
        <mxCell id="fixed_assets" value="pc_fixed_assets (資產主檔)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="320" height="440" as="geometry" />
        </mxCell>
        <mxCell id="fixed_assets_fields" value="PK  id: bigint (主鍵)&#xa;UK  asset_number: varchar(50) 資產編號*&#xa;    asset_name: varchar(200) 資產名稱*&#xa;    specification: varchar(500) 規格&#xa;    quantity: int 數量*&#xa;    unit: varchar(20) 單位*&#xa;FK  asset_class_id: bigint 資產分類ID*&#xa;FK  asset_category_id: bigint 資產類別ID*&#xa;FK  asset_attribute_id: bigint 資產屬性ID*&#xa;FK  department_id: bigint 使用部門ID*&#xa;    department_name: varchar(100) 使用部門名稱&#xa;FK  storage_location_id: bigint 存放位置ID&#xa;    storage_location: varchar(200) 存放位置&#xa;FK  keeper_id: bigint 保管人ID&#xa;    keeper_name: varchar(100) 保管人姓名&#xa;    acquisition_date: date 取得日期*&#xa;    original_value: bigint 原始成本*&#xa;    residual_rate: decimal(5,2) 殘值率%&#xa;    depreciation_years: int 折舊年限*&#xa;FK  depreciation_category: varchar(50) 折舊科目*&#xa;FK  cumulative_category: varchar(50) 累積折舊科目*&#xa;    disposal_status: varchar(20) 處置狀態 (ACTIVE=使用中,DISPOSED=已處置)&#xa;    created_at: timestamp&#xa;    updated_at: timestamp" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="fixed_assets">
          <mxGeometry y="30" width="320" height="410" as="geometry" />
        </mxCell>

        <!-- 資產處置記錄 -->
        <mxCell id="disposal_records" value="pc_asset_disposal_records (資產處置記錄)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="550" y="100" width="400" height="520" as="geometry" />
        </mxCell>
        <mxCell id="disposal_records_fields" value="PK  id: bigint (主鍵)&#xa;FK  asset_id: bigint 資產ID*&#xa;    asset_number: varchar(50) 資產編號&#xa;    asset_name: varchar(200) 資產名稱&#xa;    disposal_date: date 處置日期*&#xa;       (預設=今日,可更改)&#xa;    disposal_type: varchar(20) 處置方式*&#xa;       (SALE=出售, SCRAP=報廢, DONATION=捐贈, LOSS=遺失)&#xa;    original_value: bigint 原始成本&#xa;       (取自資產主檔)&#xa;    accumulated_depreciation: bigint 累積折舊&#xa;       (計算至處置日期為止)&#xa;    net_book_value: bigint 帳面價值&#xa;       (原始成本 - 累積折舊)&#xa;    disposal_price: bigint 處置價格*&#xa;       (出售時為售價,報廢時為0)&#xa;    disposal_profit_loss: bigint 處置損益&#xa;       (處置價格 - 帳面價值)&#xa;       (正值=處置利益, 負值=處置損失)&#xa;    reason: text 處置原因*&#xa;    remark: text 備註&#xa;    buyer_name: varchar(100) 買方名稱 (出售時必填)&#xa;    buyer_contact: varchar(100) 買方聯絡方式 (出售時必填)&#xa;    status: varchar(20) 狀態 (PENDING=待審核,APPROVED=已核准,REJECTED=已駁回)&#xa;    approved_by: bigint 核准人ID&#xa;    approved_at: timestamp 核准時間&#xa;    created_by: bigint 建立人ID&#xa;    created_at: timestamp&#xa;    updated_at: timestamp&#xa;&#xa;【說明】&#xa;- 處置後資產狀態更新為已處置 (DISPOSED)&#xa;- 累積折舊計算至處置日期為止&#xa;- 處置損益自動計算: 處置價格 - 帳面價值" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="disposal_records">
          <mxGeometry y="30" width="400" height="490" as="geometry" />
        </mxCell>

        <!-- 資產每月攤提明細 -->
        <mxCell id="depreciation_details" value="pc_asset_monthly_depreciation_details (每月攤提明細)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="580" width="350" height="220" as="geometry" />
        </mxCell>
        <mxCell id="depreciation_details_fields" value="PK  id: bigint (主鍵)&#xa;FK  asset_id: bigint 資產ID*&#xa;    depreciation_month: varchar(10) 折舊年月*&#xa;    cost_total: bigint 成本總額&#xa;    monthly_amortization: bigint 每月攤提*&#xa;    accumulated_depreciation: bigint 累積折舊&#xa;       (處置時取得累積折舊金額)&#xa;FK  department_id: bigint 折舊部門*&#xa;FK  depreciation_category: varchar(50) 折舊科目*&#xa;FK  cumulative_category: varchar(50) 累積折舊科目*&#xa;    closed_flag: char(1) 月結註記 (Y/N)&#xa;    created_at: timestamp&#xa;    updated_at: timestamp" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="depreciation_details">
          <mxGeometry y="30" width="350" height="190" as="geometry" />
        </mxCell>

        <!-- OA部門主檔 -->
        <mxCell id="departments" value="sc_departments (OA部門主檔)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1050" y="100" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="departments_fields" value="PK  id: bigint&#xa;    code: varchar(20) 部門編號&#xa;    name: varchar(100) 部門名稱&#xa;    created_at: timestamp&#xa;    updated_at: timestamp" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="departments">
          <mxGeometry y="30" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- OA會計科目主檔 -->
        <mxCell id="account_subjects" value="sc_account_subjects (OA會計科目主檔)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1050" y="260" width="240" height="140" as="geometry" />
        </mxCell>
        <mxCell id="account_subjects_fields" value="PK  id: bigint&#xa;    code: varchar(20) 科目代碼&#xa;    name: varchar(100) 科目名稱&#xa;    type: varchar(20) 科目類型&#xa;    created_at: timestamp&#xa;    updated_at: timestamp" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="account_subjects">
          <mxGeometry y="30" width="240" height="110" as="geometry" />
        </mxCell>

        <!-- 業務規則說明 -->
        <mxCell id="business_rules" value="【業務規則說明】" style="swimlane;fontStyle=1;align=left;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="550" y="660" width="740" height="780" as="geometry" />
        </mxCell>
        <mxCell id="business_rules_content" value="【作業目的】&#xa;提供資產處置功能,記錄資產之出售、報廢、捐贈或遺失等處置作業,並計算處置損益&#xa;&#xa;【作業流程】&#xa;1. 輸入資產編號(必填)或點擊「選擇資產」按鈕&#xa;2. 系統顯示資產基本資訊&#xa;3. 輸入處置日期(必填,預設=今日,可更改)&#xa;4. 選擇處置方式(必填):&#xa;   - 出售 (SALE)&#xa;   - 報廢 (SCRAP)&#xa;   - 捐贈 (DONATION)&#xa;   - 遺失 (LOSS)&#xa;5. 系統自動計算累積折舊及帳面價值&#xa;6. 輸入處置價格(必填,報廢時預設=0)&#xa;7. 系統自動計算處置損益&#xa;8. 若處置方式為出售,輸入買方名稱及聯絡方式(必填)&#xa;9. 輸入處置原因(必填)&#xa;10. 輸入備註(選填)&#xa;11. 點擊「儲存」按鈕&#xa;12. 系統產生處置記錄,進入核准流程&#xa;&#xa;【累積折舊計算】&#xa;◆ 計算邏輯:&#xa;  - 至「資產每月攤提明細」中,取得處置日期為止之所有折舊資料&#xa;  - 累積折舊 = SUM(monthly_amortization)&#xa;  - 僅計算處置日期之前的月份&#xa;&#xa;範例:&#xa;  處置日期 = 114/10/15&#xa;  - 計算 114/10 及之前月份之每月攤提金額&#xa;  - 累積折舊 = 114/01 + 114/02 + ... + 114/10 之每月攤提總和&#xa;&#xa;◆ 處置當月折舊:&#xa;  - 若處置日期在當月1-15日,當月不計算折舊&#xa;  - 若處置日期在當月16-31日,當月計算完整折舊&#xa;  - 範例:&#xa;    處置日期 = 114/10/15 → 114/10 不計算折舊&#xa;    處置日期 = 114/10/16 → 114/10 計算完整折舊&#xa;&#xa;【帳面價值計算】&#xa;◆ 計算公式: 帳面價值 = 原始成本 - 累積折舊&#xa;◆ 帳面價值不可為負值&#xa;◆ 若帳面價值 < 0,系統需提示錯誤訊息&#xa;&#xa;【處置損益計算】&#xa;◆ 計算公式: 處置損益 = 處置價格 - 帳面價值&#xa;◆ 處置損益判斷:&#xa;  - 處置損益 > 0: 處置利益 (計入其他收入)&#xa;  - 處置損益 = 0: 無損益&#xa;  - 處置損益 < 0: 處置損失 (計入其他費用)&#xa;&#xa;範例:&#xa;  原始成本 = 100,000&#xa;  累積折舊 = 60,000&#xa;  帳面價值 = 40,000&#xa;  處置價格 = 50,000&#xa;  處置損益 = 50,000 - 40,000 = 10,000 (處置利益)&#xa;&#xa;【處置方式邏輯】&#xa;◆ 出售 (SALE):&#xa;  - 處置價格: 必填,輸入售價&#xa;  - 買方名稱: 必填&#xa;  - 買方聯絡方式: 必填&#xa;  - 處置損益: 自動計算&#xa;&#xa;◆ 報廢 (SCRAP):&#xa;  - 處置價格: 預設=0,可修改 (殘值)&#xa;  - 買方名稱: 不需填寫&#xa;  - 買方聯絡方式: 不需填寫&#xa;  - 處置損益: 通常為處置損失&#xa;&#xa;◆ 捐贈 (DONATION):&#xa;  - 處置價格: 預設=0&#xa;  - 買方名稱: 填寫受贈單位&#xa;  - 買方聯絡方式: 填寫受贈單位聯絡方式&#xa;  - 處置損益: 通常為處置損失&#xa;&#xa;◆ 遺失 (LOSS):&#xa;  - 處置價格: 預設=0&#xa;  - 買方名稱: 不需填寫&#xa;  - 買方聯絡方式: 不需填寫&#xa;  - 處置損益: 為處置損失&#xa;&#xa;【資產主檔更新】&#xa;◆ 核准後處理:&#xa;  - 更新 disposal_status = DISPOSED (已處置)&#xa;  - 資產處置後,不再計算折舊&#xa;  - 資產處置後,不可再進行修改、移轉等作業&#xa;&#xa;【核准流程】&#xa;◆ 處置作業需核准:&#xa;  - 儲存後狀態為PENDING (待審核)&#xa;  - 寄送核准通知郵件給核准人&#xa;  - 核准人可在系統中進行核准或駁回&#xa;  - 核准後更新狀態為APPROVED (已核准)&#xa;  - 核准後更新資產主檔之處置狀態&#xa;  - 駁回後更新狀態為REJECTED (已駁回)&#xa;  - 駁回後不更新資產主檔&#xa;&#xa;◆ 核准人設定:&#xa;  - 預設為資產管理人員 (權限設定)&#xa;  - 可在系統設定中指定特定人員&#xa;&#xa;【處置記錄欄位】&#xa;◆ 處置日期: 必填,預設=今日,可更改&#xa;◆ 處置方式: 必填,下拉式選單 (SALE/SCRAP/DONATION/LOSS)&#xa;◆ 原始成本: 自動帶出,唯讀&#xa;◆ 累積折舊: 自動計算,唯讀&#xa;◆ 帳面價值: 自動計算,唯讀&#xa;◆ 處置價格: 必填,數字輸入&#xa;◆ 處置損益: 自動計算,唯讀&#xa;◆ 處置原因: 必填,文字輸入&#xa;◆ 備註: 選填,文字輸入&#xa;◆ 買方名稱: 出售/捐贈時必填&#xa;◆ 買方聯絡方式: 出售/捐贈時必填&#xa;◆ 狀態: 自動產生,不可編輯 (PENDING/APPROVED/REJECTED)&#xa;&#xa;【欄位驗證】&#xa;◆ 資產編號: 必填,需存在於資產主檔,且disposal_status=ACTIVE&#xa;◆ 處置日期: 必填,日期格式,不可早於取得日期&#xa;◆ 處置方式: 必填,需為SALE/SCRAP/DONATION/LOSS之一&#xa;◆ 處置價格: 必填,數字,不可為負值&#xa;◆ 買方名稱: 出售/捐贈時必填,100字以內&#xa;◆ 買方聯絡方式: 出售/捐贈時必填,100字以內&#xa;◆ 處置原因: 必填,文字輸入&#xa;&#xa;【查詢功能】&#xa;◆ 查詢條件:&#xa;  - 資產編號: 選填&#xa;  - 處置日期區間: 選填&#xa;  - 處置方式: 選填&#xa;  - 狀態: 選填&#xa;  - 使用部門: 選填&#xa;&#xa;◆ 查詢結果欄位:&#xa;  1. 處置日期&#xa;  2. 資產編號&#xa;  3. 資產名稱&#xa;  4. 處置方式&#xa;  5. 原始成本&#xa;  6. 累積折舊&#xa;  7. 帳面價值&#xa;  8. 處置價格&#xa;  9. 處置損益&#xa;  10. 狀態&#xa;  11. 核准人&#xa;  12. 核准時間&#xa;&#xa;◆ 排序: 依處置日期倒序排序&#xa;&#xa;【特殊說明】&#xa;- 處置作業需核准,核准後才更新資產主檔&#xa;- 處置當月折舊依處置日期判斷是否計算&#xa;- 處置損益自動計算,正值為利益,負值為損失&#xa;- 資產處置後,不可再進行修改、移轉等作業&#xa;- 已處置之資產不可重複處置" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="business_rules">
          <mxGeometry y="30" width="740" height="750" as="geometry" />
        </mxCell>

