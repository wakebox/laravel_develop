<mxfile host="app.diagrams.net" modified="2026-01-27T00:00:00.000Z" agent="5.0" version="24.0.0" etag="drawio-er-asset-creation">
  <diagram name="資產資料建立 ER Model" id="er-diagram-asset-creation">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- 標題 -->
        <mxCell id="title" value="資產資料建立 ER Model (01_SA)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="520" y="20" width="560" height="40" as="geometry" />
        </mxCell>

        <!-- 固定資產主表 pc_fixed_assets -->
        <mxCell id="fixed_assets" value="pc_fixed_assets (固定資產主表)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="280" height="820" as="geometry" />
        </mxCell>
        <mxCell id="fixed_assets_fields" value="【基本區】&#xa;PK  id: bigint (主鍵)&#xa;UK  asset_number: varchar(50) 財產編號*&#xa;    asset_name: varchar(200) 財產名稱*&#xa;    asset_spec: varchar(500) 資產規格&#xa;    unit: varchar(20) 單位*&#xa;    supplier: varchar(50) 供應商&#xa;    acquisition_date: date 取得日期&#xa;    initial_quantity: tinyint 列管/列帳*&#xa;       1=列管且列帳 2=列管不列帳 3=列帳不列管&#xa;FK  keeper_id: bigint 保管人ID*&#xa;FK  department_id: bigint 部門編號&#xa;    location: varchar(200) 存放地點&#xa;    acquisition_amount: int 取得數量 (固定=1)&#xa;    acquisition_price: bigint 取得成本*&#xa;    cost_not_depreciated: bigint 成本總和&#xa;       (預設=取得成本)&#xa;FK  main_asset_number: varchar(50) 主財產編號*&#xa;FK  account_subject: varchar(50) 帳務科目*&#xa;    budget_source: bigint 預留殘值&#xa;    extension: tinyint 抵押狀態 (1未抵押/2已抵押)&#xa;    investment: tinyint 投保狀態 (1未投保/2已投保)&#xa;&#xa;【折舊區】&#xa;FK  depreciation_category: varchar(50) 折舊科目*&#xa;FK  cumulative_depreciation_category: varchar(50) 累積折舊科目*&#xa;    start_date: varchar(10) 開始提列年月* (110/09)&#xa;    useful_life_months: int 耐用年限_個月*&#xa;    used_life_months: int 續用年限_個月&#xa;    residual_value_rate: int 估前累折&#xa;    zero: char(1) 資產殘值攤提至0* (Y/N)&#xa;    continued: int 續提月數 (預設12)&#xa;&#xa;【異動區】&#xa;    add_amount: bigint 增添改良&#xa;    add_date: date 增添改良日期&#xa;    original_value: bigint 重估差價&#xa;    stock_value: int 庫存數量 (預設=取得數量)&#xa;    close_date: varchar(10) 關帳年月 (唯讀)&#xa;&#xa;【系統欄位】&#xa;    created_at: timestamp 建立時間&#xa;    updated_at: timestamp 更新時間&#xa;    deleted_at: timestamp 刪除時間" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="fixed_assets">
          <mxGeometry y="30" width="280" height="790" as="geometry" />
        </mxCell>

        <!-- 異動記錄明細表 pc_asset_transaction_details -->
        <mxCell id="transaction_details" value="pc_asset_transaction_details (異動記錄明細)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="100" width="280" height="320" as="geometry" />
        </mxCell>
        <mxCell id="transaction_details_fields" value="PK  id: bigint (主鍵)&#xa;FK  asset_id: bigint 資產ID*&#xa;    serial_number: int 序號 (自動流水)&#xa;    type: tinyint 異動類型*&#xa;       1=新增 2=出售 3=報廢 4=移轉 5=改良&#xa;FK  keeper_id: bigint 保管人 (單頭保管人)&#xa;    transaction_quantity: int 異動數量&#xa;    transaction_amount: bigint 資產取得成本&#xa;       (若類型=2/3/4 則存異動單號)&#xa;    transaction_date: date 異動時間*&#xa;    created_at: timestamp 建立時間&#xa;    updated_at: timestamp 更新時間&#xa;&#xa;【說明】&#xa;- 新增資產時自動建立異動記錄&#xa;- 異動類型=1 (新增)&#xa;- 保管人=單頭保管人&#xa;- 異動數量=取得數量&#xa;- 資產取得成本=取得成本&#xa;- 異動時間=建立時間" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="transaction_details">
          <mxGeometry y="30" width="280" height="290" as="geometry" />
        </mxCell>

        <!-- OA員工主檔 sc_users -->
        <mxCell id="users" value="sc_users (OA員工主檔)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
