<mxfile host="app.diagrams.net" modified="2026-01-27T00:00:00.000Z" agent="5.0" version="24.0.0" etag="drawio-er-insurance-report">
  <diagram name="資產投保明細表 ER Model" id="er-diagram-insurance-report">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- 標題 -->
        <mxCell id="title" value="資產投保明細表 ER Model" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="520" y="20" width="560" height="40" as="geometry" />
        </mxCell>

        <!-- 資產投保作業表 -->
        <mxCell id="insurance" value="pc_asset_insurance (資產投保作業)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="100" width="300" height="380" as="geometry" />
        </mxCell>
        <mxCell id="insurance_fields" value="PK  id: bigint (主鍵)&#xa;UK  insurance_number: varchar(50) ERP投保單號*&#xa;FK  asset_id: bigint 資產ID*&#xa;    asset_number: varchar(50) 財產編號*&#xa;    asset_name: varchar(200) 財產名稱&#xa;    start_date: date 投保期間(起)*&#xa;    end_date: date 投保期間(迄)*&#xa;    insurance_type: varchar(100) 保險險別&#xa;    insurance_company: varchar(200) 承保公司&#xa;    policy_number: varchar(100) 保單號碼&#xa;    insurance_amount: varchar(100) 投保金額&#xa;    status: tinyint 保單狀態*&#xa;       1=投保中 2=已結束 3=已到期&#xa;    created_at: timestamp&#xa;    updated_at: timestamp&#xa;&#xa;【報表查詢條件】&#xa;- 財產編號(複選)&#xa;- 投保期間(起/迄)&#xa;&#xa;【報表排序】&#xa;- 依財產編號排序" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="insurance">
          <mxGeometry y="30" width="300" height="350" as="geometry" />
        </mxCell>

        <!-- 固定資產主表 -->
        <mxCell id="fixed_assets" value="pc_fixed_assets (固定資產主表)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="750" y="100" width="280" height="160" as="geometry" />
        </mxCell>
        <mxCell id="fixed_assets_fields" value="PK  id: bigint (主鍵)&#xa;UK  asset_number: varchar(50) 財產編號*&#xa;    asset_name: varchar(200) 財產名稱*&#xa;    created_at: timestamp&#xa;    updated_at: timestamp&#xa;&#xa;【說明】&#xa;- 作為報表查詢條件來源" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="fixed_assets">
          <mxGeometry y="30" width="280" height="130" as="geometry" />
        </mxCell>

        <!-- 業務規則說明 -->
        <mxCell id="business_rules" value="【業務規則說明】" style="swimlane;fontStyle=1;align=left;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="520" width="730" height="420" as="geometry" />
        </mxCell>
        <mxCell id="business_rules_content" value="【作業目的】&#xa;資產投保明細報表&#xa;&#xa;【查詢條件說明】&#xa;◆ 財產編號:&#xa;  - 複選清單&#xa;  - 非必要條件,若無下此條件當作全部查詢&#xa;&#xa;◆ 投保期間(起):&#xa;  - 萬年曆選單&#xa;  - 用於過濾投保開始日期&#xa;&#xa;◆ 投保期間(迄):&#xa;  - 萬年曆選單&#xa;  - 用於過濾投保結束日期&#xa;&#xa;【報表內容】&#xa;◆ 排序:&#xa;  - 依財產編號排序&#xa;&#xa;◆ 表頭欄位:&#xa;  - 公司名稱: 依客戶公司名稱顯示&#xa;  - 頁次: 依頁次顯示&#xa;  - 印表日期: 依系統日顯示 (YYY/MM/DD)&#xa;&#xa;◆ 表格欄位:&#xa;  1. 序號: 系統自動流水號產生&#xa;  2. 財產編號: 依資產投保作業之財產編號&#xa;  3. 財產名稱: 依資產投保作業之財產名稱&#xa;  4. 保險險別: 依資產投保作業之保險險別&#xa;  5. 承保公司: 依資產投保作業之承保公司&#xa;  6. ERP投保單號: 依資產投保作業之ERP投保單號&#xa;  7. 保單號碼: 依資產投保作業之保單號碼&#xa;  8. 投保金額: 依資產投保作業之投保金額&#xa;  9. 保單狀態: 依資產投保作業之保單狀態&#xa;      1=投保中, 2=已結束, 3=已到期&#xa;&#xa;【資料來源】&#xa;- 主要來源: pc_asset_insurance (資產投保作業表)&#xa;- 關聯表: pc_fixed_assets (固定資產主表)&#xa;&#xa;【報表特性】&#xa;◆ 報表類型:&#xa;  - 查詢報表&#xa;  - 不涉及資料新增/修改/刪除&#xa;&#xa;◆ 報表格式:&#xa;  - 列表式報表&#xa;  - 可匯出Excel/PDF&#xa;&#xa;◆ 資料過濾:&#xa;  - 可依財產編號過濾(多選)&#xa;  - 可依投保期間過濾&#xa;  - 未選擇條件時顯示全部資料&#xa;&#xa;【查詢邏輯】&#xa;SELECT 序號, 財產編號, 財產名稱, 保險險別, 承保公司,&#xa;       ERP投保單號, 保單號碼, 投保金額, 保單狀態&#xa;FROM pc_asset_insurance&#xa;WHERE (財產編號 IN (選擇的財產編號清單) OR 未選擇財產編號)&#xa;  AND (投保期間起 >= 查詢起日 OR 未選擇起日)&#xa;  AND (投保期間迄 <= 查詢迄日 OR 未選擇迄日)&#xa;ORDER BY 財產編號" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="business_rules">
          <mxGeometry y="30" width="730" height="390" as="geometry" />
        </mxCell>

        <!-- 關聯線 -->
        <!-- insurance -> fixed_assets -->
        <mxCell id="rel1" value="" style="endArrow=ERone;html=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=ERmany;startFill=0;endFill=0;" edge="1" parent="1" source="insurance" target="fixed_assets">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel1_label" value="N : 1&#xa;關聯資產" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="rel1">
          <mxGeometry x="-0.1" y="1" relative="1" as="geometry">
            <mxPoint x="5" y="-15" as="offset" />
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>