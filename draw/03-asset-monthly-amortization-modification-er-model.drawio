        <mxCell id="rel2" value="" style="endArrow=ERmany;html=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=ERone;startFill=0;endFill=0;" edge="1" parent="1" source="monthly_depreciation" target="depreciation_details">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel2_label" value="1 : N&#xa;折舊明細" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="rel2">
          <mxGeometry x="-0.1" y="1" relative="1" as="geometry">
            <mxPoint x="5" y="-15" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- fixed_assets -> depreciation_details -->
        <mxCell id="rel3" value="" style="endArrow=ERmany;html=1;rounded=0;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;startArrow=ERone;startFill=0;endFill=0;dashed=1;" edge="1" parent="1" source="fixed_assets" target="depreciation_details">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="850" y="170"/>
              <mxPoint x="850" y="210"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="rel3_label" value="1 : N&#xa;直接關聯" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="rel3">
          <mxGeometry x="-0.1" y="1" relative="1" as="geometry">
            <mxPoint x="5" y="-15" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- departments -> depreciation_details -->
        <mxCell id="rel4" value="" style="endArrow=ERmany;html=1;rounded=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;startArrow=ERone;startFill=0;endFill=0;" edge="1" parent="1" source="departments" target="depreciation_details">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel4_label" value="1 : N&#xa;折舊部門" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="rel4">
          <mxGeometry x="-0.1" y="1" relative="1" as="geometry">
