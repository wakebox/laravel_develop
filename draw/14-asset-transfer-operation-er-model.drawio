<mxfile host="app.diagrams.net" modified="2026-01-27T00:00:00.000Z" agent="5.0" version="24.0.0" etag="drawio-er-transfer-operation">
  <diagram name="資產移轉作業 ER Model" id="er-diagram-transfer-operation">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- 標題 -->
        <mxCell id="title" value="資產移轉作業 ER Model" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="450" y="20" width="700" height="40" as="geometry" />
        </mxCell>

        <!-- 資產主檔 -->
        <mxCell id="fixed_assets" value="pc_fixed_assets (資產主檔)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="320" height="420" as="geometry" />
        </mxCell>
        <mxCell id="fixed_assets_fields" value="PK  id: bigint (主鍵)&#xa;UK  asset_number: varchar(50) 資產編號*&#xa;    asset_name: varchar(200) 資產名稱*&#xa;    specification: varchar(500) 規格&#xa;    quantity: int 數量*&#xa;    unit: varchar(20) 單位*&#xa;FK  asset_class_id: bigint 資產分類ID*&#xa;FK  asset_category_id: bigint 資產類別ID*&#xa;FK  asset_attribute_id: bigint 資產屬性ID*&#xa;FK  department_id: bigint 使用部門ID*&#xa;    department_name: varchar(100) 使用部門名稱&#xa;       (移轉後更新)&#xa;FK  storage_location_id: bigint 存放位置ID&#xa;    storage_location: varchar(200) 存放位置&#xa;FK  keeper_id: bigint 保管人ID&#xa;    keeper_name: varchar(100) 保管人姓名&#xa;       (移轉後更新)&#xa;    acquisition_date: date 取得日期*&#xa;    original_value: bigint 原始成本*&#xa;    residual_rate: decimal(5,2) 殘值率%&#xa;    depreciation_years: int 折舊年限*&#xa;FK  depreciation_category: varchar(50) 折舊科目*&#xa;FK  cumulative_category: varchar(50) 累積折舊科目*&#xa;    created_at: timestamp&#xa;    updated_at: timestamp" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="fixed_assets">
          <mxGeometry y="30" width="320" height="390" as="geometry" />
        </mxCell>

        <!-- 資產移轉記錄 -->
        <mxCell id="transfer_records" value="pc_asset_transfer_records (資產移轉記錄)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="550" y="100" width="380" height="420" as="geometry" />
        </mxCell>
        <mxCell id="transfer_records_fields" value="PK  id: bigint (主鍵)&#xa;FK  asset_id: bigint 資產ID*&#xa;    asset_number: varchar(50) 資產編號&#xa;    asset_name: varchar(200) 資產名稱&#xa;    transfer_date: date 移轉日期*&#xa;       (預設=今日,可更改)&#xa;    transfer_type: varchar(20) 移轉類型*&#xa;       (KEEPER=保管人移轉, DEPARTMENT=部門移轉)&#xa;FK  original_keeper_id: bigint 原保管人ID&#xa;    original_keeper_name: varchar(100) 原保管人姓名&#xa;FK  new_keeper_id: bigint 新保管人ID&#xa;    new_keeper_name: varchar(100) 新保管人姓名&#xa;FK  original_department_id: bigint 原使用部門ID&#xa;    original_department_name: varchar(100) 原使用部門名稱&#xa;FK  new_department_id: bigint 新使用部門ID&#xa;    new_department_name: varchar(100) 新使用部門名稱&#xa;    reason: text 移轉原因&#xa;    remark: text 備註&#xa;    status: varchar(20) 狀態 (PENDING=待審核,APPROVED=已核准,REJECTED=已駁回)&#xa;    approved_by: bigint 核准人ID&#xa;    approved_at: timestamp 核准時間&#xa;    created_by: bigint 建立人ID&#xa;    created_at: timestamp&#xa;    updated_at: timestamp&#xa;&#xa;【說明】&#xa;- 保管人移轉: 僅更新保管人,部門不變&#xa;- 部門移轉: 更新部門及保管人,需核准流程" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="transfer_records">
          <mxGeometry y="30" width="380" height="390" as="geometry" />
        </mxCell>

        <!-- OA部門主檔 -->
        <mxCell id="departments" value="sc_departments (OA部門主檔)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1050" y="100" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="departments_fields" value="PK  id: bigint&#xa;    code: varchar(20) 部門編號&#xa;    name: varchar(100) 部門名稱&#xa;    created_at: timestamp&#xa;    updated_at: timestamp" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="departments">
          <mxGeometry y="30" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- OA員工主檔 -->
        <mxCell id="employees" value="sc_employees (OA員工主檔)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1050" y="260" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="employees_fields" value="PK  id: bigint&#xa;    code: varchar(20) 員工編號&#xa;    name: varchar(100) 員工姓名&#xa;    email: varchar(100) Email&#xa;    created_at: timestamp&#xa;    updated_at: timestamp" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="employees">
          <mxGeometry y="30" width="220" height="110" as="geometry" />
        </mxCell>

        <!-- 資產每月攤提明細 -->
        <mxCell id="depreciation_details" value="pc_asset_monthly_depreciation_details (每月攤提明細)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="560" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="depreciation_details_fields" value="PK  id: bigint (主鍵)&#xa;FK  asset_id: bigint 資產ID*&#xa;    depreciation_month: varchar(10) 折舊年月*&#xa;    monthly_amortization: bigint 每月攤提*&#xa;FK  department_id: bigint 折舊部門*&#xa;       (移轉後更新當月及後續月份)&#xa;FK  depreciation_category: varchar(50) 折舊科目*&#xa;FK  cumulative_category: varchar(50) 累積折舊科目*&#xa;    closed_flag: char(1) 月結註記 (Y/N)&#xa;    created_at: timestamp&#xa;    updated_at: timestamp" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="depreciation_details">
          <mxGeometry y="30" width="320" height="170" as="geometry" />
        </mxCell>

        <!-- 業務規則說明 -->
        <mxCell id="business_rules" value="【業務規則說明】" style="swimlane;fontStyle=1;align=left;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="550" y="560" width="720" height="700" as="geometry" />
        </mxCell>
        <mxCell id="business_rules_content" value="【作業目的】&#xa;提供資產保管人或使用部門移轉功能,記錄資產移轉歷程&#xa;&#xa;【作業流程】&#xa;1. 輸入資產編號(必填)或點擊「選擇資產」按鈕&#xa;2. 系統顯示資產基本資訊&#xa;3. 選擇移轉類型(必填):&#xa;   - 保管人移轉: 僅更新保管人,部門不變&#xa;   - 部門移轉: 更新部門及保管人,需核准流程&#xa;4. 輸入移轉日期(必填,預設=今日,可更改)&#xa;5. 選擇新保管人(必填)&#xa;6. 若為部門移轉,選擇新使用部門(必填)&#xa;7. 輸入移轉原因(選填)&#xa;8. 輸入備註(選填)&#xa;9. 點擊「儲存」按鈕&#xa;10. 系統產生移轉記錄&#xa;11. 若為部門移轉,進入核准流程&#xa;&#xa;【移轉類型邏輯】&#xa;◆ 保管人移轉 (KEEPER):&#xa;  - 僅更新資產主檔之保管人&#xa;  - 使用部門不變&#xa;  - 不需核准流程&#xa;  - 儲存後立即生效&#xa;  - 狀態預設為APPROVED (已核准)&#xa;&#xa;◆ 部門移轉 (DEPARTMENT):&#xa;  - 更新資產主檔之使用部門及保管人&#xa;  - 需進入核准流程&#xa;  - 儲存後狀態為PENDING (待審核)&#xa;  - 核准後才更新資產主檔&#xa;  - 核准後更新狀態為APPROVED (已核准)&#xa;  - 駁回後更新狀態為REJECTED (已駁回)&#xa;&#xa;【資產主檔更新邏輯】&#xa;◆ 保管人移轉:&#xa;  - 更新 keeper_id = 新保管人ID&#xa;  - 更新 keeper_name = 新保管人姓名&#xa;  - 使用部門不變&#xa;&#xa;◆ 部門移轉 (核准後):&#xa;  - 更新 department_id = 新使用部門ID&#xa;  - 更新 department_name = 新使用部門名稱&#xa;  - 更新 keeper_id = 新保管人ID&#xa;  - 更新 keeper_name = 新保管人姓名&#xa;&#xa;【每月攤提明細更新邏輯】&#xa;◆ 部門移轉 (核准後):&#xa;  - 更新資產每月攤提明細之折舊部門&#xa;  - 僅更新移轉日期當月及後續月份&#xa;  - 已月結之月份 (closed_flag=Y) 不更新&#xa;  - 更新 department_id = 新使用部門ID&#xa;&#xa;範例:&#xa;  移轉日期 = 114/10/15&#xa;  - 更新 114/10, 114/11, 114/12... 之折舊部門&#xa;  - 不更新 114/09 及之前月份&#xa;  - 若 114/10 已月結 (closed_flag=Y),則不更新&#xa;&#xa;【核准流程】&#xa;◆ 部門移轉需核准:&#xa;  - 儲存後狀態為PENDING (待審核)&#xa;  - 寄送核准通知郵件給核准人&#xa;  - 核准人可在系統中進行核准或駁回&#xa;  - 核准後更新狀態為APPROVED (已核准)&#xa;  - 核准後更新資產主檔及每月攤提明細&#xa;  - 駁回後更新狀態為REJECTED (已駁回)&#xa;  - 駁回後不更新資產主檔及每月攤提明細&#xa;&#xa;◆ 核准人設定:&#xa;  - 預設為資產管理人員 (權限設定)&#xa;  - 可在系統設定中指定特定人員&#xa;&#xa;【移轉記錄欄位】&#xa;◆ 移轉日期: 必填,預設=今日,可更改&#xa;◆ 移轉類型: 必填,下拉式選單&#xa;  - KEEPER = 保管人移轉&#xa;  - DEPARTMENT = 部門移轉&#xa;◆ 原保管人: 自動帶出,唯讀&#xa;◆ 新保管人: 必填,從OA員工主檔挑選&#xa;◆ 原使用部門: 自動帶出,唯讀&#xa;◆ 新使用部門: 若為部門移轉則必填,從OA部門主檔挑選&#xa;◆ 移轉原因: 選填,文字輸入&#xa;◆ 備註: 選填,文字輸入&#xa;◆ 狀態: 自動產生,不可編輯&#xa;  - PENDING = 待審核&#xa;  - APPROVED = 已核准&#xa;  - REJECTED = 已駁回&#xa;&#xa;【欄位驗證】&#xa;◆ 資產編號: 必填,需存在於資產主檔&#xa;◆ 移轉類型: 必填,需為KEEPER或DEPARTMENT&#xa;◆ 移轉日期: 必填,日期格式&#xa;◆ 新保管人: 必填,需存在於OA員工主檔&#xa;◆ 新使用部門: 若為部門移轉則必填,需存在於OA部門主檔&#xa;◆ 新保管人不可與原保管人相同&#xa;◆ 新使用部門不可與原使用部門相同 (部門移轉時)&#xa;&#xa;【查詢功能】&#xa;◆ 查詢條件:&#xa;  - 資產編號: 選填&#xa;  - 移轉日期區間: 選填&#xa;  - 移轉類型: 選填&#xa;  - 狀態: 選填&#xa;  - 原使用部門: 選填&#xa;  - 新使用部門: 選填&#xa;  - 原保管人: 選填&#xa;  - 新保管人: 選填&#xa;&#xa;◆ 查詢結果欄位:&#xa;  1. 移轉日期&#xa;  2. 資產編號&#xa;  3. 資產名稱&#xa;  4. 移轉類型&#xa;  5. 原保管人&#xa;  6. 新保管人&#xa;  7. 原使用部門&#xa;  8. 新使用部門&#xa;  9. 狀態&#xa;  10. 核准人&#xa;  11. 核准時間&#xa;&#xa;◆ 排序: 依移轉日期倒序排序&#xa;&#xa;【特殊說明】&#xa;- 保管人移轉不需核准,儲存後立即生效&#xa;- 部門移轉需核准,核准後才更新資產主檔&#xa;- 部門移轉會同步更新每月攤提明細之折舊部門 (移轉日期當月及後續月份)&#xa;- 已月結之月份不更新折舊部門" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="business_rules">
          <mxGeometry y="30" width="720" height="670" as="geometry" />
        </mxCell>

