  <diagram name="資產重估作業 ER Model" id="er-diagram-revaluation-operation">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- 標題 -->
        <mxCell id="title" value="資產重估作業 ER Model" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="450" y="20" width="700" height="40" as="geometry" />
        </mxCell>

        <!-- 資產主檔 -->
        <mxCell id="fixed_assets" value="pc_fixed_assets (資產主檔)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="320" height="460" as="geometry" />
        </mxCell>
        <mxCell id="fixed_assets_fields" value="PK  id: bigint (主鍵)&#xa;UK  asset_number: varchar(50) 資產編號*&#xa;    asset_name: varchar(200) 資產名稱*&#xa;    specification: varchar(500) 規格&#xa;    quantity: int 數量*&#xa;    unit: varchar(20) 單位*&#xa;FK  asset_class_id: bigint 資產分類ID*&#xa;FK  asset_category_id: bigint 資產類別ID*&#xa;FK  asset_attribute_id: bigint 資產屬性ID*&#xa;FK  department_id: bigint 使用部門ID*&#xa;    department_name: varchar(100) 使用部門名稱&#xa;FK  storage_location_id: bigint 存放位置ID&#xa;    storage_location: varchar(200) 存放位置&#xa;FK  keeper_id: bigint 保管人ID&#xa;    keeper_name: varchar(100) 保管人姓名&#xa;    acquisition_date: date 取得日期*&#xa;    original_value: bigint 原始成本*&#xa;       (重估後更新為重估後成本)&#xa;    residual_rate: decimal(5,2) 殘值率%&#xa;    depreciation_years: int 折舊年限*&#xa;FK  depreciation_category: varchar(50) 折舊科目*&#xa;FK  cumulative_category: varchar(50) 累積折舊科目*&#xa;    revaluation_count: int 重估次數 (預設=0)&#xa;    last_revaluation_date: date 最後重估日期&#xa;    created_at: timestamp&#xa;    updated_at: timestamp" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="fixed_assets">
          <mxGeometry y="30" width="320" height="430" as="geometry" />
        </mxCell>

        <!-- 資產重估記錄 -->
        <mxCell id="revaluation_records" value="pc_asset_revaluation_records (資產重估記錄)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="550" y="100" width="420" height="500" as="geometry" />
        </mxCell>
        <mxCell id="revaluation_records_fields" value="PK  id: bigint (主鍵)&#xa;FK  asset_id: bigint 資產ID*&#xa;    asset_number: varchar(50) 資產編號&#xa;    asset_name: varchar(200) 資產名稱&#xa;    revaluation_date: date 重估日期*&#xa;       (預設=今日,可更改)&#xa;    original_value_before: bigint 重估前原始成本&#xa;       (取自資產主檔)&#xa;    accumulated_depreciation_before: bigint 重估前累積折舊&#xa;       (計算至重估日期為止)&#xa;    net_book_value_before: bigint 重估前帳面價值&#xa;       (重估前原始成本 - 重估前累積折舊)&#xa;    revaluation_value: bigint 重估價值*&#xa;       (評估後之資產公允價值)&#xa;    revaluation_difference: bigint 重估增減值&#xa;       (重估價值 - 重估前帳面價值)&#xa;       (正值=重估增值, 負值=重估減值)&#xa;    original_value_after: bigint 重估後原始成本&#xa;       (重估價值)&#xa;    accumulated_depreciation_after: bigint 重估後累積折舊&#xa;       (預設=0, 重估後重新計算折舊)&#xa;    reason: text 重估原因*&#xa;    remark: text 備註&#xa;    appraiser: varchar(100) 評估單位 (選填)&#xa;    appraisal_report: varchar(500) 評估報告檔案路徑 (選填)&#xa;    status: varchar(20) 狀態 (PENDING=待審核,APPROVED=已核准,REJECTED=已駁回)&#xa;    approved_by: bigint 核准人ID&#xa;    approved_at: timestamp 核准時間&#xa;    created_by: bigint 建立人ID&#xa;    created_at: timestamp&#xa;    updated_at: timestamp&#xa;&#xa;【說明】&#xa;- 重估後資產之原始成本更新為重估價值&#xa;- 重估後累積折舊歸零,重新開始計算折舊&#xa;- 重估增減值記錄於重估記錄中" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="revaluation_records">
          <mxGeometry y="30" width="420" height="470" as="geometry" />
        </mxCell>

        <!-- 資產每月攤提明細 -->
        <mxCell id="depreciation_details" value="pc_asset_monthly_depreciation_details (每月攤提明細)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="600" width="370" height="240" as="geometry" />
        </mxCell>
        <mxCell id="depreciation_details_fields" value="PK  id: bigint (主鍵)&#xa;FK  asset_id: bigint 資產ID*&#xa;    depreciation_month: varchar(10) 折舊年月*&#xa;    cost_total: bigint 成本總額&#xa;       (重估後更新為重估價值)&#xa;    monthly_amortization: bigint 每月攤提*&#xa;       (重估後重新計算)&#xa;    accumulated_depreciation: bigint 累積折舊&#xa;FK  department_id: bigint 折舊部門*&#xa;FK  depreciation_category: varchar(50) 折舊科目*&#xa;FK  cumulative_category: varchar(50) 累積折舊科目*&#xa;    closed_flag: char(1) 月結註記 (Y/N)&#xa;    created_at: timestamp&#xa;    updated_at: timestamp&#xa;&#xa;【說明】&#xa;- 重估後,重估當月及後續月份之折舊重新計算" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="depreciation_details">
          <mxGeometry y="30" width="370" height="210" as="geometry" />
        </mxCell>

        <!-- OA部門主檔 -->
        <mxCell id="departments" value="sc_departments (OA部門主檔)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1050" y="100" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="departments_fields" value="PK  id: bigint&#xa;    code: varchar(20) 部門編號&#xa;    name: varchar(100) 部門名稱&#xa;    created_at: timestamp&#xa;    updated_at: timestamp" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="departments">
          <mxGeometry y="30" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- OA會計科目主檔 -->
        <mxCell id="account_subjects" value="sc_account_subjects (OA會計科目主檔)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1050" y="260" width="240" height="140" as="geometry" />
        </mxCell>
        <mxCell id="account_subjects_fields" value="PK  id: bigint&#xa;    code: varchar(20) 科目代碼&#xa;    name: varchar(100) 科目名稱&#xa;    type: varchar(20) 科目類型&#xa;    created_at: timestamp&#xa;    updated_at: timestamp" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="account_subjects">
          <mxGeometry y="30" width="240" height="110" as="geometry" />
        </mxCell>

        <!-- 業務規則說明 -->
        <mxCell id="business_rules" value="【業務規則說明】" style="swimlane;fontStyle=1;align=left;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="550" y="640" width="740" height="820" as="geometry" />
        </mxCell>
        <mxCell id="business_rules_content" value="【作業目的】&#xa;提供資產重估功能,記錄資產之重估作業,更新資產公允價值,並記錄重估增減值&#xa;&#xa;【作業流程】&#xa;1. 輸入資產編號(必填)或點擊「選擇資產」按鈕&#xa;2. 系統顯示資產基本資訊&#xa;3. 輸入重估日期(必填,預設=今日,可更改)&#xa;4. 系統自動計算重估前累積折舊及帳面價值&#xa;5. 輸入重估價值(必填,評估後之資產公允價值)&#xa;6. 系統自動計算重估增減值&#xa;7. 輸入重估原因(必填)&#xa;8. 輸入評估單位(選填)&#xa;9. 上傳評估報告(選填)&#xa;10. 輸入備註(選填)&#xa;11. 點擊「儲存」按鈕&#xa;12. 系統產生重估記錄,進入核准流程&#xa;&#xa;【累積折舊計算】&#xa;◆ 計算邏輯:&#xa;  - 至「資產每月攤提明細」中,取得重估日期為止之所有折舊資料&#xa;  - 累積折舊 = SUM(monthly_amortization)&#xa;  - 僅計算重估日期之前的月份&#xa;&#xa;範例:&#xa;  重估日期 = 114/10/15&#xa;  - 計算 114/10 及之前月份之每月攤提金額&#xa;  - 累積折舊 = 114/01 + 114/02 + ... + 114/10 之每月攤提總和&#xa;&#xa;◆ 重估當月折舊:&#xa;  - 若重估日期在當月1-15日,當月不計算折舊&#xa;  - 若重估日期在當月16-31日,當月計算完整折舊&#xa;  - 範例:&#xa;    重估日期 = 114/10/15 → 114/10 不計算折舊&#xa;    重估日期 = 114/10/16 → 114/10 計算完整折舊&#xa;&#xa;【帳面價值計算】&#xa;◆ 計算公式: 帳面價值 = 重估前原始成本 - 重估前累積折舊&#xa;◆ 帳面價值不可為負值&#xa;◆ 若帳面價值 < 0,系統需提示錯誤訊息&#xa;&#xa;【重估增減值計算】&#xa;◆ 計算公式: 重估增減值 = 重估價值 - 重估前帳面價值&#xa;◆ 重估增減值判斷:&#xa;  - 重估增減值 > 0: 重估增值 (計入未實現重估增值)&#xa;  - 重估增減值 = 0: 無重估增減值&#xa;  - 重估增減值 < 0: 重估減值 (計入重估損失)&#xa;&#xa;範例:&#xa;  重估前原始成本 = 100,000&#xa;  重估前累積折舊 = 60,000&#xa;  重估前帳面價值 = 40,000&#xa;  重估價值 = 80,000&#xa;  重估增減值 = 80,000 - 40,000 = 40,000 (重估增值)&#xa;&#xa;【資產主檔更新】&#xa;◆ 核准後處理:&#xa;  - 更新 original_value = 重估價值&#xa;  - 更新 revaluation_count = revaluation_count + 1&#xa;  - 更新 last_revaluation_date = 重估日期&#xa;&#xa;【每月攤提明細更新】&#xa;◆ 核准後處理:&#xa;  - 更新重估當月及後續月份之折舊資料&#xa;  - 已月結之月份 (closed_flag=Y) 不更新&#xa;  - 更新 cost_total = 重估價值&#xa;  - 重新計算 monthly_amortization (每月攤提)&#xa;  - 重新計算 accumulated_depreciation (累積折舊)&#xa;&#xa;範例:&#xa;  重估日期 = 114/10/15&#xa;  重估價值 = 80,000&#xa;  折舊年限 = 5年 (剩餘48個月)&#xa;  殘值率 = 10%&#xa;  - 更新 114/10, 114/11, 114/12... 之折舊資料&#xa;  - 不更新 114/09 及之前月份&#xa;  - 若 114/10 已月結 (closed_flag=Y),則不更新&#xa;  - 每月攤提 = (80,000 * (1 - 10%)) / 48 = 1,500&#xa;&#xa;【折舊計算邏輯】&#xa;◆ 重估後折舊計算:&#xa;  - 成本總額 = 重估價值&#xa;  - 殘值 = 重估價值 * 殘值率%&#xa;  - 應提折舊額 = 重估價值 - 殘值&#xa;  - 剩餘折舊月數 = 原折舊年限 * 12 - 已折舊月數&#xa;  - 每月攤提 = 應提折舊額 / 剩餘折舊月數&#xa;&#xa;範例:&#xa;  重估價值 = 80,000&#xa;  殘值率 = 10%&#xa;  殘值 = 8,000&#xa;  應提折舊額 = 72,000&#xa;  原折舊年限 = 5年 (60個月)&#xa;  已折舊月數 = 12個月&#xa;  剩餘折舊月數 = 48個月&#xa;  每月攤提 = 72,000 / 48 = 1,500&#xa;&#xa;【核准流程】&#xa;◆ 重估作業需核准:&#xa;  - 儲存後狀態為PENDING (待審核)&#xa;  - 寄送核准通知郵件給核准人&#xa;  - 核准人可在系統中進行核准或駁回&#xa;  - 核准後更新狀態為APPROVED (已核准)&#xa;  - 核准後更新資產主檔及每月攤提明細&#xa;  - 駁回後更新狀態為REJECTED (已駁回)&#xa;  - 駁回後不更新資產主檔及每月攤提明細&#xa;&#xa;◆ 核准人設定:&#xa;  - 預設為資產管理人員 (權限設定)&#xa;  - 可在系統設定中指定特定人員&#xa;&#xa;【重估記錄欄位】&#xa;◆ 重估日期: 必填,預設=今日,可更改&#xa;◆ 重估前原始成本: 自動帶出,唯讀&#xa;◆ 重估前累積折舊: 自動計算,唯讀&#xa;◆ 重估前帳面價值: 自動計算,唯讀&#xa;◆ 重估價值: 必填,數字輸入&#xa;◆ 重估增減值: 自動計算,唯讀&#xa;◆ 重估後原始成本: 自動計算,唯讀 (=重估價值)&#xa;◆ 重估後累積折舊: 自動計算,唯讀 (=0)&#xa;◆ 重估原因: 必填,文字輸入&#xa;◆ 評估單位: 選填,文字輸入&#xa;◆ 評估報告: 選填,檔案上傳&#xa;◆ 備註: 選填,文字輸入&#xa;◆ 狀態: 自動產生,不可編輯 (PENDING/APPROVED/REJECTED)&#xa;&#xa;【欄位驗證】&#xa;◆ 資產編號: 必填,需存在於資產主檔&#xa;◆ 重估日期: 必填,日期格式,不可早於取得日期&#xa;◆ 重估價值: 必填,數字,不可為負值&#xa;◆ 重估原因: 必填,文字輸入&#xa;◆ 評估單位: 選填,100字以內&#xa;◆ 評估報告: 選填,檔案格式限PDF&#xa;&#xa;【查詢功能】&#xa;◆ 查詢條件:&#xa;  - 資產編號: 選填&#xa;  - 重估日期區間: 選填&#xa;  - 狀態: 選填&#xa;  - 使用部門: 選填&#xa;&#xa;◆ 查詢結果欄位:&#xa;  1. 重估日期&#xa;  2. 資產編號&#xa;  3. 資產名稱&#xa;  4. 重估前原始成本&#xa;  5. 重估前累積折舊&#xa;  6. 重估前帳面價值&#xa;  7. 重估價值&#xa;  8. 重估增減值&#xa;  9. 狀態&#xa;  10. 核准人&#xa;  11. 核准時間&#xa;&#xa;◆ 排序: 依重估日期倒序排序&#xa;&#xa;【特殊說明】&#xa;- 重估作業需核准,核准後才更新資產主檔&#xa;- 重估當月折舊依重估日期判斷是否計算&#xa;- 重估增減值自動計算,正值為增值,負值為減值&#xa;- 重估後資產之原始成本更新為重估價值&#xa;- 重估後累積折舊歸零,重新開始計算折舊&#xa;- 重估後折舊依剩餘折舊年限重新計算每月攤提" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10;" vertex="1" parent="business_rules">
          <mxGeometry y="30" width="740" height="790" as="geometry" />
        </mxCell>

        <!-- 關聯線 -->
