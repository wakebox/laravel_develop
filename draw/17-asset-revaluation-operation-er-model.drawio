        <!-- fixed_assets -> depreciation_details -->
        <mxCell id="rel2" value="" style="endArrow=ERmany;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;startArrow=ERone;startFill=0;endFill=0;dashed=1;" edge="1" parent="1" source="fixed_assets" target="depreciation_details">
          <mxGeometry relative="1" as="geometry" />
